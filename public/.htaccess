# Deployed to the site root with every build (Next.js copies public/ into out/).
# The host is LiteSpeed (Apache-compatible), deployed via additive scp — files
# removed from the build are never deleted remotely, so retired pages are
# tombstoned here with 410s.

# ── Force HTTPS ──────────────────────────────────────────────────────────────
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Custom 404 ──────────────────────────────────────────────────────────────
# The static export builds a branded 404.html; without this the host serves
# its own generic "404 Not Found" page for unknown URLs.
ErrorDocument 404 /404.html

# ── Tombstones for files removed from the build (scp never deletes) ─────────
# Done with mod_rewrite [G] — LiteSpeed ignores mod_alias "Redirect gone" for
# directories that still exist on disk. Sandwell General's A&E closed in
# 2024; PAH SDEC publishes no live wait.
RewriteRule ^hospitals/sandwell-general-hospital(/|$) - [G,L]
RewriteRule ^hospitals/princess-alexandra-hospital-sdec(/|$) - [G,L]

<IfModule mod_headers.c>
  # HSTS — only meaningful on HTTPS responses
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # Content-hashed Next.js assets (all JS/CSS/fonts live under /_next/static)
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML carries live wait data refreshed every 30 min — always revalidate
  # (cheap 304s via Last-Modified, never heuristic-stale)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

